# --- AI copilot (free key at console.groq.com) ---
GROQ_API_KEY=
AEGIS_LLM_MODEL=llama-3.3-70b-versatile
# any OpenAI-compatible chat endpoint works (Groq is the default)
# AEGIS_LLM_URL=https://api.groq.com/openai/v1/chat/completions

# --- Engineer PIN (guard on/off, rule edits, AI autonomy) ---
AEGIS_ENGINEER_PIN=2468

# --- Operator alerts by SMS + phone call (Twilio). Leave blank = dashboard only ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# comma-separated: first number gets the text/call, the rest are the escalation chain
ALERT_TO=
# minutes before an unacknowledged critical incident escalates to the next contact
ESCALATE_MIN=10

# --- Storage / ports ---
AEGIS_DB=data/audit.db
AEGIS_GUARD_PORT=5502
AEGIS_PLC_PORT=5020
# AEGIS_TAGS=config/tags.json
# AEGIS_POLICY=config/policy.json

# --- Audit log: set a long random secret to make the hash chain keyed (HMAC) ---
# AEGIS_AUDIT_KEY=
# AEGIS_PLANT_NAME=Hattiesburg Water Treatment Plant #2 (simulated)
# AEGIS_HOST=127.0.0.1
# AEGIS_PROCESS=config/process.json

# --- Hardening (production) ---
# AEGIS_DEMO=0                    # turn off simulator controls and demo accounts
# AEGIS_SESSION_SECRET=           # long random string (sessions survive restarts)
# AEGIS_POLICY_KEY=               # sign the policy file; edits made outside Aegis are detected
# AEGIS_SYSLOG=10.0.0.20:514      # send every audit entry to a log server / SIEM
# AEGIS_HTTPS=1                   # when behind a TLS reverse proxy (secure cookies)
